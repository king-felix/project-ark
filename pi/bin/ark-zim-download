#!/usr/bin/env bash
# =============================================================================
#  Project ARK — background offline-library downloader (resumable, polite)
#
#  Runs as a long-lived service.  Every cycle it takes the next "todo" row from
#  the pinned queue, fetches it single-stream with wget (resumes after reboots
#  and power cuts), files it into the library and refreshes kiwix.
#
#  Safety rules baked in:
#    * never more than one download at a time  (keeps the hotspot responsive)
#    * stops when the card reaches the space the box keeps back (ark-space)
#    * /etc/ark/zim-pause  -> pause without stopping the service
#    * nothing is ever deleted; a re-run just skips what is already there
# =============================================================================
set -Eeuo pipefail

ZIM_DIR="${ZIM_DIR:-/srv/ark/kiwix}"
QUEUE="${QUEUE:-/etc/ark/zim-queue.tsv}"
STATE="$ZIM_DIR/state"
STATUS="$STATE/status.json"
PAUSE="${PAUSE:-/etc/ark/zim-pause}"
PROFILE_FILE="${PROFILE_FILE:-/etc/ark/zim-profile}"
RESOLVE="${RESOLVE:-/usr/local/bin/ark-zim-resolve}"
REBUILD="${REBUILD:-/usr/local/bin/ark-kiwix-library}"
LOG_DIR="${LOG_DIR:-/srv/ark/logs}"
# The reserve is not this script's number: /usr/local/sbin/ark-space answers with
# the card's own arithmetic (7 % of it, or 2 GiB), the same one an upload and a
# film are measured against.  No second policy lives here.
SPACE="${SPACE:-/usr/local/sbin/ark-space}"
# The digest the mirror publishes for these exact bytes.  A byte count catches a
# stalled transfer; it does not catch a mirror that served a different file of
# the same length, which opens as a library with no books in it.
CHECK="${CHECK:-/usr/local/bin/ark-zim-checksum}"
# ---- how we fetch -----------------------------------------------------------
# aria2 was the original fetcher: faster when a mirror is generous, but the KiWix
# redirector hands out mirrors that collapse under parallel streams. Measured on
# this box, aria2 froze at 66,881 bytes on 4 connections while wget and curl held
# ~1 MiB/s on ONE connection to the same URL — and aria2's stale .aria2 control
# files kept "resuming" into pieces that were never written (a 3.5 GB file with
# only 1.9 GB allocated: full size, impossible to open). A single stream that
# reaches the end beats a fast one that never does, so the fetchers here are
# wget first, curl second — both OpenSSL, both honest about resume.
ZIM_POLITE="${ZIM_POLITE:-1}"
ZIM_RATE_LIMIT="${ZIM_RATE_LIMIT:-4M}"
WGET_ARGS=(-c -nv --tries=4 --timeout=30 --waitretry=10)
CURL_ARGS=(-sSL -C - --retry 3 --retry-delay 10 --connect-timeout 15
           --speed-limit 51200 --speed-time 30)
if [[ "$ZIM_POLITE" != "0" ]]; then
  WGET_ARGS+=(--limit-rate="$ZIM_RATE_LIMIT")
  CURL_ARGS+=(--limit-rate "$ZIM_RATE_LIMIT")
fi
IDLE_SLEEP="${IDLE_SLEEP:-900}"
PROGRESS_EVERY="${PROGRESS_EVERY:-15}"   # seconds between status.json updates while a bundle downloads

mkdir -p "$ZIM_DIR" "$STATE" "$LOG_DIR"
LOG="$LOG_DIR/zim-download.log"
QUAR="${QUAR:-/srv/ark/quarantine}"   # unreadable downloads go here, out of kiwix's sight

log() { printf '%s  %s\n' "$(date -Is)" "$*" >>"$LOG"; }

# Only ONE downloader may touch the library at a time. Two instances writing the
# same .part file corrupt each other: the survivor keeps writing into an inode
# that the other instance has already renamed to the final .zim.
LOCK="$STATE/downloader.lock"
exec 9>"$LOCK"
if ! flock -n 9; then
  log "another downloader already holds $LOCK — exiting"
  exit 0
fi

room_for() {   # [bytes] — may this much be added without crossing the reserve?
  # No number asks "may anything be added at all?" — the question before another
  # fetch starts.  `--need 0` cannot answer it: nothing is bigger than what is
  # left, so it always says yes.
  if [[ -x "$SPACE" ]]; then
    if [[ $# -eq 0 ]]; then
      "$SPACE" --check --path "$ZIM_DIR"
    else
      "$SPACE" --check --need "$1" --path "$ZIM_DIR"
    fi
  else
    # A box installed before the policy existed still has the old floor; refusing
    # to download is safer than downloading into a card with no room at all.
    local b
    b="$(df -B1 --output=avail "$ZIM_DIR" 2>/dev/null | tail -1 | tr -dc '0-9')"
    (( ${b:-0} > 2147483648 ))
  fi
}

free_gib() {   # REPORTING ONLY: the policy is room_for(); this is what a page shows
  local b
  b="$(df -B1 --output=avail "$ZIM_DIR" 2>/dev/null | tail -1 | tr -dc '0-9')"
  if [[ -z "$b" ]]; then            # non-GNU df (used by the local test harness)
    b="$(df -kP "$ZIM_DIR" 2>/dev/null | awk 'NR==2 {print $4 * 1024}')"
  fi
  printf '%s' $(( ${b:-0} / 1073741824 ))
}

queue_count() {   # <status>
  awk -F'\t' -v s="$1" '$1==s {n++} END {print n+0}' "$QUEUE" 2>/dev/null || echo 0
}

bytes_total() {
  awk -F'\t' '$1=="todo" || $1=="have" {n+=$3} END {printf "%d", n+0}' "$QUEUE" 2>/dev/null || echo 0
}

bytes_present() {
  local f sz n=0
  shopt -s nullglob
  for f in "$ZIM_DIR"/*.zim; do
    sz="$(stat -c %s "$f" 2>/dev/null || stat -f %z "$f" 2>/dev/null || echo 0)"
    n=$(( n + sz ))
  done
  printf '%s' "$n"
}

write_status() {   # <current-label> <current-bytes-done> [<current-bytes-total>] [<bytes-per-second>]
  local current="${1:-}" done_b="${2:-0}" want_b="${3:-0}" rate="${4:-0}" total have todo
  total="$(queue_count todo)"; have="$(queue_count have)"
  cat >"$STATUS.tmp" <<JSON
{"updated":"$(date -Is)","profile":"$(cat "$PROFILE_FILE" 2>/dev/null || echo core)","total":$(( total + have )),"present":$have,"pending":$total,"bytes_total":$(bytes_total),"bytes_on_disk":$(bytes_present),"current":"$current","current_bytes":$done_b,"current_total":$want_b,"current_rate_bps":${rate:-0},"free_gib":$(free_gib),"paused":$([[ -e "$PAUSE" ]] && echo true || echo false)}
JSON
  mv -f "$STATUS.tmp" "$STATUS"
  chmod 644 "$STATUS"
}

part_bytes() {   # <file> — size of a download in progress, 0 if it vanished
  stat -c %s "$1" 2>/dev/null || stat -f %z "$1" 2>/dev/null || echo 0
}

have_zim() {   # <filename> — present AND readable by kiwix, else it is not a bundle
  local f="$ZIM_DIR/$1" lib="$ZIM_DIR/library.xml"
  [[ -f "$f" ]] || return 1
  [[ -s "$lib" ]] || return 0          # no index yet: trust the file
  grep -q "path=\"$1\"" "$lib"
}

mark_have() {   # <filename>  — flip the queue row so the counts stay honest
  awk -F'\t' -v f="$1" -v OFS='\t' \
      '$1=="todo" && $4==f {$1="have"} {print}' "$QUEUE" >"$QUEUE.tmp"
  mv -f "$QUEUE.tmp" "$QUEUE"
  chmod 644 "$QUEUE"
}

refresh_library() {
  if [[ -x "$REBUILD" ]]; then
    "$REBUILD" >>"$LOG" 2>&1 || log "library rebuild failed (see log)"
  fi
  if systemctl list-unit-files ark-kiwix.service >/dev/null 2>&1; then
    if systemctl is-active --quiet ark-kiwix.service; then
      systemctl try-restart ark-kiwix.service || log "kiwix restart failed"
    else
      systemctl start ark-kiwix.service || log "kiwix start failed"
    fi
  fi
}

fetch_one() {   # <url> <bytes> <filename> <label>
  local url=$1 bytes=$2 name=$3 label=$4 part="$ZIM_DIR/$3.part" got=0 attempt=0
  log "fetching $name ($label)"
  write_status "$label" 0 "$bytes"
  # Respect a bundle that is already complete: without this, a second pass (or a
  # revived queue entry) re-downloads over the good file. "Complete" means kiwix
  # can actually read it — a truncated ZIM is the same size on disk but worthless
  # on the shelf, so size alone is not proof (it once hid a 770-byte-short file).
  if [[ -s "$ZIM_DIR/$name" ]]; then
    got="$(stat -c %s "$ZIM_DIR/$name" 2>/dev/null || stat -f %z "$ZIM_DIR/$name" 2>/dev/null || echo 0)"
    if (( got >= bytes - bytes / 100 )) && have_zim "$name"; then
      log "already have $name ($got bytes) — skipping"
      date -Is >"$STATE/$name.done"
      return 0
    fi
    if (( got >= bytes - bytes / 100 )); then
      log "quarantining unreadable $name ($got bytes) — fetching it again"
      mkdir -p "$QUAR"
      mv -f "$ZIM_DIR/$name" "$QUAR/$name.bad-$(date +%Y%m%d%H%M%S)"
      rm -f "$ZIM_DIR/$name.aria2"   # a stale control file is what created the mess
    fi
  fi
  while (( attempt < 3 )); do
    attempt=$(( attempt + 1 ))
    if (( attempt == 1 )); then
      wget "${WGET_ARGS[@]}" -O "$part" "$url" >>"$LOG" 2>&1 &
    else
      curl "${CURL_ARGS[@]}" -o "$part" "$url" >>"$LOG" 2>&1 &
    fi
    local fpid=$! rc=0 waited=0 prev_b=0 prev_t rate=0 now_b now_t
    prev_t="$(date +%s)"
    prev_b="$(part_bytes "$part")"
    # Report progress while it runs, otherwise a 4 GiB bundle is a silent hour
    # on the home page. The fetcher is a background job so this loop can look at
    # the file it is writing.
    while kill -0 "$fpid" 2>/dev/null; do
      sleep 5
      waited=$(( waited + 5 ))
      if (( waited % PROGRESS_EVERY == 0 )); then
        now_b="$(part_bytes "$part")"; now_t="$(date +%s)"
        rate=0
        if (( now_t > prev_t && now_b > prev_b )); then
          rate=$(( (now_b - prev_b) / (now_t - prev_t) ))
        fi
        # A resume or a stalled mirror can make the difference zero or negative;
        # report zero rather than a made-up speed (the page shows an ETA only
        # when this number is real).
        (( rate > 0 )) || rate=0
        write_status "$label" "$now_b" "$bytes" "$rate"
        prev_b=$now_b; prev_t=$now_t
      fi
    done
    if wait "$fpid"; then rc=0; else rc=$?; fi
    if (( rc == 0 )); then break; fi
    log "attempt $attempt for $name failed (exit $rc); backing off $(( attempt * 30 ))s"
    sleep $(( attempt * 30 ))
  done
  got="$(part_bytes "$part")"
  # the catalogue "length" is the exact file size; allow 1% for republished files
  if (( got < bytes - bytes / 100 )); then
    log "incomplete $name: $got of $bytes bytes — keeping the partial file"
    return 1
  fi
  # Size can lie. A stale .aria2 control file makes aria2 "resume" into pieces
  # that were never written, so the file reaches full size full of holes and
  # opens nowhere (seen live: 3.5 GB claimed, 1.9 GB actually allocated). Compare
  # the blocks on disk with the bytes claimed before trusting the file.
  local alloc
  alloc="$(du -B1 "$part" 2>/dev/null | cut -f1 || true)"   # || true: du only fails on a vanished file
  if [[ -n "$alloc" ]] && (( alloc < got - got / 50 )); then
    log "corrupt $name: $got bytes claimed, only $alloc allocated (holes) — discarding for a clean retry"
    rm -f "$part" "$part.aria2" "$ZIM_DIR/$name.aria2"
    return 1
  fi
  # Size and blocks can both be right and it is still not the file the catalogue
  # promised.  Ask the mirror for the digest it publishes for these exact bytes
  # and compare before the file is given its final name.  Exit 3 (nothing
  # published) is not a failure — but it is written down as unverified, never
  # counted as verified, so a mirror that stops publishing digests is visible
  # in the log instead of silently changing what "checked" means.
  local sha="" vrc=9
  if [[ -x "$CHECK" ]]; then
    sha="$("$CHECK" --url "$url" --file "$part" 2>>"$LOG")" || vrc=$?
  fi
  case "$vrc" in
    0)  printf '%s  %s\n' "$sha" "$name" >"$STATE/$name.sha256"
        log "checksum ok $name ($sha)" ;;
    1)  log "checksum MISMATCH for $name — the mirror served different bytes; keeping nothing"
        rm -f "$part"
        return 1 ;;
    2)  log "cannot read $part to check it — starting this one again"
        return 1 ;;
    3)  log "no published checksum for $name — kept unverified (size and blocks checked)" ;;
    *)  log "checksum helper $CHECK is missing — $name kept unverified" ;;
  esac
  mv -f "$part" "$ZIM_DIR/$name"
  chmod 644 "$ZIM_DIR/$name"
  date -Is >"$STATE/$name.done"
  log "complete $name ($got bytes)"
  return 0
}

trap 'log "signal received — stopping"; write_status "" 0; exit 0' TERM INT

log "downloader started (queue=$QUEUE; the space policy is asked before every fetch)"
refresh_library || true      # build the library from whatever is already on disk
fails=0

while true; do
  if [[ -e "$PAUSE" ]]; then
    write_status "paused" 0
    sleep 600
    continue
  fi
  if ! room_for; then
    log "the card is inside the space the box keeps back — waiting before the next download"
    write_status "waiting for space" 0
    sleep 1800
    continue
  fi
  if [[ ! -s "$QUEUE" ]] || (( $(queue_count unresolved) > 0 )); then
    "$RESOLVE" >>"$LOG" 2>&1 || log "catalogue resolution failed (offline?)"
  fi

  row="$(awk -F'\t' '$1=="todo" {print; exit}' "$QUEUE" 2>/dev/null || true)"
  if [[ -z "$row" ]]; then
    write_status "" 0
    sleep "$IDLE_SLEEP"
    continue
  fi

  IFS=$'\t' read -r _st url bytes name tier label <<<"$row"
  if have_zim "$name"; then
    mark_have "$name"
    continue
  fi
  # A collection has a known size, so the space is promised before the first byte
  # instead of discovered at 99 %.  A download that already has a `.part` only
  # needs the rest: asking for the whole size again would make a resumed 90 GB
  # fetch impossible on a card that has 40 GB free and 45 GB already written.
  have_b="$(stat -c %s "$ZIM_DIR/$name.part" 2>/dev/null || stat -f %z "$ZIM_DIR/$name.part" 2>/dev/null || echo 0)"
  need_b=$(( ${bytes:-0} - ${have_b:-0} ))
  (( need_b < 0 )) && need_b=0
  if ! room_for "$need_b"; then
    log "$name does not fit in the space left — waiting before fetching it"
    write_status "$label (waiting for space)" 0
    sleep 1800
    continue
  fi
  if fetch_one "$url" "$bytes" "$name" "$label"; then
    mark_have "$name"
    fails=0
    refresh_library || true
  else
    fails=$(( fails + 1 ))
    log "$name will be retried later (failure $fails)"
    write_status "$label (retrying)" 0
    if (( fails >= 5 )); then
      log "five consecutive failures — pausing for an hour"
      sleep 3600
      fails=0
    else
      sleep 300
    fi
  fi
done

