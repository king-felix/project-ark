#!/usr/bin/env bash
# =============================================================================
#  Project ARK — rebuild the offline library index from the ZIM files on disk.
#
#  Called by ark-kiwix.service (ExecStartPre) and by the downloader after every
#  completed file, so the catalogue can never point at a file that is gone and
#  can never miss one that was copied on by hand.
# =============================================================================
set -Eeuo pipefail

ZIM_DIR="${ZIM_DIR:-/srv/ark/kiwix}"
LIB="$ZIM_DIR/library.xml"

if ! command -v kiwix-manage >/dev/null 2>&1; then
  echo "kiwix-manage is not installed" >&2
  exit 1
fi

shopt -s nullglob
zims=("$ZIM_DIR"/*.zim)
if (( ${#zims[@]} == 0 )); then
  echo "no bundles yet in $ZIM_DIR — nothing to index" >&2
  exit 1
fi

# The catalogue is built IN the folder it describes.  kiwix-manage writes each
# bundle's path relative to the folder holding the library file, so an index
# built elsewhere and then moved to /srv/ark/kiwix records
# "/srv/ark/srv/ark/kiwix/<name>.zim" — a path that does not exist.  The box then
# serves a library whose every book is unopenable: the viewer 404s and search
# answers "Content not found", while `kiwix-manage … show` looks perfectly
# healthy.  Built here, the paths come out as bare file names and the files are
# found.
#
# No lock file, on purpose: this runs both as root (the downloader) and as `pi`
# (the service), so a lock in this folder is a file one of them cannot open, and
# a failed lock takes the whole library down.  Two builders racing is harmless —
# each writes its own uniquely named complete index and renames it into place.
tmp="$(mktemp "$ZIM_DIR/.library-XXXXXX")"
rm -f "$tmp"                     # kiwix-manage wants to create the file itself
# a build killed mid-run leaves one behind; it is not a catalogue and not a bundle
find "$ZIM_DIR" -maxdepth 1 -name '.library-*' -mmin +60 -delete 2>/dev/null || true

# Publish by rename, and hand the file to the folder's owner.  This script runs
# as root from the downloader and as `pi` from the service, and a catalogue left
# owned by the other one cannot be edited in place — the library then refuses to
# start and says only "Permission denied".
publish() {
  chmod 644 "$1"
  chown --reference="$ZIM_DIR" "$1" 2>/dev/null || true
  mv -f "$1" "$LIB"
}

if kiwix-manage "$tmp" add "${zims[@]}" >/dev/null 2>&1; then
  publish "$tmp"
  printf 'library.xml rebuilt: %d bundle(s)\n' "${#zims[@]}"
  exit 0
fi

# A single corrupt ZIM must not cost us the whole catalogue: index one by one,
# into a fresh file so that the old owner cannot block the rebuild.
echo "bulk index failed — retrying bundle by bundle" >&2
rm -f "$tmp"
ok=0
for zim in "${zims[@]}"; do
  if kiwix-manage "$tmp" add "$zim" >/dev/null 2>&1; then
    ok=$(( ok + 1 ))
  else
    echo "  ! unreadable bundle: $(basename "$zim")" >&2
  fi
done
printf 'library.xml rebuilt bundle by bundle: %d of %d\n' "$ok" "${#zims[@]}"
if (( ok > 0 )); then
  publish "$tmp"
  exit 0
fi
rm -f "$tmp"
exit 1
