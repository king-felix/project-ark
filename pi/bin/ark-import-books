#!/srv/ark/venv/bin/python3
# =============================================================================
#  PROJECT ARK — add books dropped into the File Box to the Book Library
#
#  Usage:  sudo ark-import-books                # scan the drop folder
#          sudo ark-import-books FILE [FILE...] # import specific files
#          ark-import-books --status            # how many books are there?
#
#  Strategy:
#    1. If a `calibredb` binary exists, use it (fast, exact).
#    2. Otherwise drive Calibre-Web's own upload endpoint over loopback, which
#       writes the Calibre database itself (no calibre install needed).
#  Books are never deleted. A book dropped in the incoming folder moves to
#  calibre-incoming/done once it is in the library; a copy the File Box serves
#  stays where it is so its download link keeps working. Either way the content
#  fingerprint is written to calibre-incoming/.imported.json, so the same book
#  is never added twice — even if it is dropped again under a different name.
# =============================================================================
import argparse
import hashlib
import json
import os
import re
import shutil
import sqlite3
import sys
import time
import urllib.error
import urllib.request

LIBRARY = "/srv/ark/calibre-library"
METADATA = os.path.join(LIBRARY, "metadata.db")
DROP_DIRS = ("/srv/ark/drop/files", "/srv/ark/calibre-incoming")
DONE_DIR = "/srv/ark/calibre-incoming/done"
CRED_FILE = "/etc/ark/calibre-admin"
BASE_URL = "http://127.0.0.1:8083"
BOOK_EXT = {
    ".epub", ".pdf", ".mobi", ".azw", ".azw3", ".fb2", ".djvu",
    ".cbz", ".cbr", ".cb7", ".txt", ".rtf", ".doc", ".docx", ".odt",
    ".html", ".htm", ".lit", ".pdb", ".prc", ".ibooks", ".azw4", ".kepub",
}


def log(msg):
    print(f"[import] {msg}", flush=True)


def _stamp():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _sha256(path):
    """The content fingerprint the ledger is keyed by. Empty when unreadable."""
    digest = hashlib.sha256()
    try:
        with open(path, "rb") as fh:
            for block in iter(lambda: fh.read(1024 * 1024), b""):
                digest.update(block)
    except OSError as exc:
        log(f"cannot read {path}: {exc}")
        return ""
    return digest.hexdigest()


def ledger_path():
    """The record of what has already been imported, beside the done folder."""
    return os.path.join(os.path.dirname(os.path.abspath(DONE_DIR)), ".imported.json")


def load_ledger():
    try:
        with open(ledger_path(), "r", encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}          # missing or damaged: import again rather than lose a book


def save_ledger(ledger):
    path = ledger_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(ledger, fh, indent=1, sort_keys=True)
            fh.write("\n")
        os.replace(tmp, path)
    except OSError as exc:
        log(f"could not write {path}: {exc}")


def book_count():
    if not os.path.exists(METADATA):
        return -1
    try:
        con = sqlite3.connect(f"file:{METADATA}?mode=ro", uri=True, timeout=10)
        try:
            return con.execute("SELECT COUNT(*) FROM books").fetchone()[0]
        finally:
            con.close()
    except sqlite3.Error as exc:
        log(f"cannot read library database: {exc}")
        return -1


def credentials():
    user, password = "admin", "admin123"
    try:
        with open(CRED_FILE, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or ":" not in line:
                    continue
                user, password = line.split(":", 1)
                break
    except OSError:
        pass
    return user, password


def _is_done(path):
    """True when a path is inside the folder that holds already-imported books."""
    done = os.path.abspath(DONE_DIR)
    return os.path.abspath(path) == done or os.path.abspath(path).startswith(done + os.sep)


def _is_book(name):
    """A finished, visible file with a book extension — and nothing else."""
    if name.startswith(".") or name.endswith(".part"):
        return False
    return os.path.splitext(name)[1].lower() in BOOK_EXT


def candidates(paths):
    """Every file that still needs importing, in a stable order.

    Three things are deliberately skipped: the ``done`` folder (its contents
    were imported on an earlier run, and scanning it made every pass offer the
    same books again), half-arrived ``.part`` files, and hidden files such as
    this importer's own ledger.
    """
    found = []
    for path in paths:
        if _is_done(path):
            continue
        if os.path.isfile(path):
            if _is_book(os.path.basename(path)):
                found.append(path)
            continue
        for root, dirs, files in os.walk(path):
            dirs[:] = sorted(d for d in dirs
                             if not d.startswith(".") and not _is_done(os.path.join(root, d)))
            for name in sorted(files):
                if _is_book(name):
                    found.append(os.path.join(root, name))
    return found


def file_box():
    """The folder the File Box serves. Its copies are never moved away."""
    return os.path.abspath(DROP_DIRS[0])


def _retire(path):
    """Move an imported book aside — unless it is a copy the File Box serves.

    ``/srv/ark/drop/files`` is the folder the portal links to, so moving a file
    out of it killed somebody's download link.  Those copies stay; the ledger is
    what stops them being imported twice.
    """
    if os.path.abspath(path).startswith(file_box() + os.sep):
        return
    try:
        os.makedirs(DONE_DIR, exist_ok=True)
        target = os.path.join(DONE_DIR, os.path.basename(path))
        if os.path.exists(target):
            stem, ext = os.path.splitext(target)
            target = f"{stem}-{int(time.time())}{ext}"
        shutil.move(path, target)
    except OSError as exc:
        log(f"could not move {path} aside: {exc}")


def calibredb_add(files):
    exe = shutil.which("calibredb")
    if not exe:
        return False
    import subprocess
    log(f"using {exe}")
    ok = True
    for path in files:
        proc = subprocess.run([exe, "add", "--library-path", LIBRARY, path],
                              capture_output=True, text=True)
        if proc.returncode == 0:
            log(f"added: {os.path.basename(path)}")
            _retire(path)
        else:
            ok = False
            log(f"failed: {os.path.basename(path)}: {proc.stderr.strip()[:200]}")
    return ok
class _Jar:
    """Tiny cookie jar so we do not depend on requests being installed."""

    def __init__(self, store):
        self.store = store

    def extract_cookies(self, response, request):
        for header in response.headers.get_all("Set-Cookie") or []:
            pair = header.split(";", 1)[0]
            if "=" in pair:
                key, value = pair.split("=", 1)
                self.store[key.strip()] = value.strip()

    def add_cookie_header(self, request):
        if self.store:
            request.add_header(
                "Cookie", "; ".join(f"{k}={v}" for k, v in self.store.items())
            )


class Session:
    """CSRF-aware GET/POST helper for Calibre-Web."""

    def __init__(self):
        self.opener = urllib.request.build_opener(
            urllib.request.HTTPCookieProcessor(_Jar({}))
        )

    def get(self, path):
        with self.opener.open(BASE_URL + path, timeout=30) as resp:
            return resp.read().decode("utf-8", "replace")

    def post(self, path, fields, files=None):
        boundary = "----ark%d" % int(time.time() * 1000)
        body = bytearray()
        for key, value in fields.items():
            body += (f"--{boundary}\r\n"
                     f'Content-Disposition: form-data; name="{key}"\r\n\r\n'
                     f"{value}\r\n").encode()
        for key, (filename, payload) in (files or {}).items():
            safe = filename.replace('"', "_")
            body += (f"--{boundary}\r\n"
                     f'Content-Disposition: form-data; name="{key}"; filename="{safe}"\r\n'
                     f"Content-Type: application/octet-stream\r\n\r\n").encode()
            body += payload
            body += b"\r\n"
        body += f"--{boundary}--\r\n".encode()
        req = urllib.request.Request(
            BASE_URL + path, data=bytes(body),
            headers={"Content-Type": f"multipart/form-data; boundary={boundary}"},
        )
        try:
            with self.opener.open(req, timeout=300) as resp:
                return resp.status, resp.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as exc:
            return exc.code, exc.read().decode("utf-8", "replace")


TOKEN_RE = re.compile(r'name="csrf_token"[^>]*value="([^"]+)"')


def csrf_token(html):
    match = TOKEN_RE.search(html)
    return match.group(1) if match else ""


def upload_via_web(files):
    session = Session()
    try:
        page = session.get("/login")
    except (urllib.error.URLError, OSError) as exc:
        log(f"Book Library is not answering on {BASE_URL}: {exc}")
        return False
    user, password = credentials()
    status, _ = session.post(
        "/login",
        {"username": user, "password": password,
         "csrf_token": csrf_token(page), "remember_me": "on", "next": "/"},
    )
    if status not in (200, 302):
        log(f"login rejected (HTTP {status}) — check {CRED_FILE}")
        return False

    token = csrf_token(session.get("/"))
    if not token:
        log("no upload form token found — is uploading enabled?")
        return False

    ok = True
    for path in files:
        with open(path, "rb") as fh:
            payload = fh.read()
        status, body = session.post(
            "/upload", {"csrf_token": token},
            {"btn-upload": (os.path.basename(path), payload)},
        )
        if status in (200, 302):
            log(f"uploaded: {os.path.basename(path)}")
            _retire(path)
        else:
            ok = False
            snippet = re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", body))[:160]
            log(f"rejected: {os.path.basename(path)} (HTTP {status}) {snippet}")
    return ok


def main(argv):
    parser = argparse.ArgumentParser(description="Import books into the ARK library")
    parser.add_argument("files", nargs="*", help="files or directories (default: drop folders)")
    parser.add_argument("--status", action="store_true", help="print the book count and exit")
    parser.add_argument("--list", action="store_true", help="list the files that would be imported")
    args = parser.parse_args(argv)

    if args.status:
        print(f"books={book_count()}")
        return 0

    files = candidates(args.files or DROP_DIRS)
    if not files:
        log("nothing new to import")
        return 0

    ledger = load_ledger()
    hashes = {path: _sha256(path) for path in files}
    fresh = [path for path in files if not hashes[path] or hashes[path] not in ledger]
    skipped = len(files) - len(fresh)
    if skipped:
        log(f"{skipped} already imported (by content) — not adding them again")
    files = fresh
    if not files:
        log("nothing new to import")
        return 0

    log(f"{len(files)} file(s) to import")
    if args.list:
        for path in files:
            print(path)
        return 0

    before = book_count()
    if not calibredb_add(files):
        if not upload_via_web(files):
            log("import failed — the files stay where they are; open http://ark.lan/books/ "
                "and use the Upload button in the browser instead")
            return 1
    after = book_count()

    # Record only what really became a book. A file still sitting in the drop
    # folder was not imported and must be offered again — except a File Box
    # copy, which stays on purpose so the download link keeps working.
    record = {}
    for path in files:
        digest = hashes.get(path)
        kept_for_links = os.path.abspath(path).startswith(file_box() + os.sep)
        if digest and (kept_for_links or not os.path.exists(path)):
            record[digest] = {"name": os.path.basename(path), "at": _stamp()}
    if record:
        ledger.update(record)
        save_ledger(ledger)
    log(f"library: {before} -> {after} book(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

