#!/usr/bin/env python3
"""ark-restore — put a backup back, and say exactly what was put back.

The order of the checks is the whole design:

1. **Prove the bundle first.**  Every file is re-read and compared with the
   fingerprint in the manifest.  A damaged bundle is refused before anything on
   the box is touched.
2. **Ask before replacing records.**  A box that already holds messages, shared
   files or accounts is not overwritten unless the owner says ``--force``; the
   message names the flag so nobody has to guess.
3. **Never replace a shared file.**  Restoring only ever *adds* a file that is
   missing from the File Box.  A name that is already there with different bytes
   is kept, and the run says so — `ark_storage.spool()` stays the only writer of
   a new file, and this tool never edits an existing one.
4. **Do not let the import list hide books.**  The list that stops a book being
   imported twice only makes sense next to the shelf it describes.  If the shelf
   is empty, it is left beside the real list with ``.from-backup`` on the end, so
   re-adding the books imports them once instead of never.
5. **Take the old journal away before the new file goes in.**  A ``-wal`` holds
   committed pages belonging to the database it was written for, so a copy put
   down beside a stale one is a copy SQLite will replay the old rows into — and a
   drain that cannot be done refuses the restore *before* anything is written
   (``drain_sidecars`` says why, and what it measured).

This is the one deliberate exception to "a backup only reads": putting records
back means writing them.  It writes only what the manifest lists, only inside the
box, and only where nothing of the same name already lives — except a named
player's save when ``--force`` replaces the records it belongs to, because bytes
from the old database and a row from the restored one would otherwise disagree
forever (``SaveConflict``).

**Nothing else may be writing while this runs.**  The web service keeps its own
handle on the old database, and a copied-in database plus a stale WAL is how a
restore looks successful and then loses rows.  Every unit that writes the
records is therefore stopped first and started again afterwards, including on
failure.  ``--no-service`` is for a card mounted on another machine, where there
is no service to stop.
"""

from __future__ import annotations

import argparse
import os
import pwd
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import ark_bundle as bundle_tools          # noqa: E402 — sibling module, by design


def say(text: str = "") -> None:
    print(text, flush=True)


def stop(text: str, code: int = 1) -> int:
    print(f"Not done: {text}", file=sys.stderr, flush=True)
    return code


class RestoreRefused(Exception):
    """A file could not be put back safely, so nothing of it was changed.

    Raised *before* the write, never after: a refusal is only useful when the box is
    exactly as it was when the sentence is printed.
    """


# ---------------------------------------------------------------------------
#  what is already here
# ---------------------------------------------------------------------------
def occupancy(paths: dict) -> str | None:
    """Why this box must not be overwritten without --force, or None if it may."""
    if paths["marker"].exists():
        return "this box is already set up"
    db = paths["db"]
    if not db.is_file():
        return None
    import sqlite3
    try:
        conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5)
        try:
            for table, word in (("notes", "messages"), ("files", "shared files"),
                                ("players", "player names"),
                                ("player_saves", "game saves"),
                                ("admins", "administrators")):
                try:
                    n = int(conn.execute(f"SELECT COUNT(*) FROM {table}").fetchone()[0])
                except sqlite3.Error:
                    continue
                if n:
                    return f"it already holds {n} {word}"
        finally:
            conn.close()
    except sqlite3.Error:
        return "there is already a database here"
    return None


# ---------------------------------------------------------------------------
#  keeping the writers quiet
# ---------------------------------------------------------------------------
#: Every unit that can hold the database or write it.  Timers and the path unit
#: come first so they cannot start a job between the stops and the copy.
#: Every unit that writes the records, so a restore stops them all before it publishes
#: anything.  ``ark-self-heal`` belongs here: since 26 Oct 2026 the daily pass at 04:17
#: writes while the box is serving (a journal-mode change, a repair, the sweep), so a
#: restore that started beside it would have two programs writing one card.
WRITERS = ("ark-book-import.path", "ark-book-import.service",
           "ark-arcade-discover.timer", "ark-arcade-discover.service",
           "ark-zim-downloader.service", "ark-self-heal.timer",
           "ark-self-heal.service", "ark-api.service")


def _systemctl(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["systemctl", *args], capture_output=True, text=True,
                          timeout=30)


def quiesce(dry: bool) -> tuple[list[str], str | None]:
    """Stop every writer that is running.  Returns (stopped, problem).

    Only units this call actually stopped are returned, so a failed stop can put
    back exactly what it took down.  A box without systemd (a card in a reader on
    another computer) is not a failure: there is nothing running to coordinate.
    """
    if not shutil.which("systemctl"):
        say("(No service manager on this machine, so there is nothing to pause.)")
        return [], None
    running = []
    for unit in WRITERS:
        try:
            state = _systemctl("is-active", unit).stdout.strip()
        except (OSError, subprocess.SubprocessError) as exc:
            return [], f"could not ask about {unit}: {exc}"
        if state == "active":
            running.append(unit)
    if not running:
        return [], None
    if dry:
        say("Would pause: " + ", ".join(running))
        return [], None
    for unit in running:
        try:
            done = _systemctl("stop", unit)
        except (OSError, subprocess.SubprocessError) as exc:
            resume(running)
            return [], f"could not pause {unit}: {exc}"
        if done.returncode != 0:
            resume(running)
            detail = (done.stderr or done.stdout or "").strip()
            return [], (f"could not pause {unit} — nothing was changed"
                        + (f" ({detail})" if detail else ""))
        say(f"Paused {unit} so nothing else writes the records.")
    return running, None


def resume(units: list[str]) -> None:
    """Start again exactly what was stopped — even when the restore failed."""
    for unit in units:
        try:
            done = _systemctl("start", unit)
        except (OSError, subprocess.SubprocessError) as exc:
            say(f"Could not start {unit} again: {exc}")
            continue
        if done.returncode != 0:
            detail = (done.stderr or done.stdout or "").strip()
            say(f"Could not start {unit} again"
                + (f": {detail}" if detail else "") + " — start it by hand.")
        else:
            say(f"Started {unit} again.")


# ---------------------------------------------------------------------------
#  putting things back
# ---------------------------------------------------------------------------
def drain_sidecars(target: Path) -> list[str]:
    """Take the *old* database's journal away from beside ``target``.

    A ``-wal`` is not a scratch file: it holds committed pages that belong to the
    database it was written for.  A copy put down *beside* one is therefore a copy
    SQLite will replay somebody else's commits into the first time anything opens
    it, and the restored file is then wrong in a way nothing has written down.
    That is not a theory — measured on 1 November 2026: a four-row database
    restored beside a stale journal came back with **51 rows**, and the same
    restore with the journal drained first came back with 4.

    So the journal goes **before** the new file, and any journal that appears
    afterwards (a writer that slipped in between) is taken away too.  The old
    journal is never moved or kept: it describes rows that are being replaced, and
    keeping it would only invite somebody to put it back later.

    Returns the sidecars that were actually removed; raises ``OSError`` when one
    cannot be, because that is the caller's cue to write nothing at all.
    """
    gone = []
    for suffix in ("-wal", "-shm"):
        sidecar = target.with_name(target.name + suffix)
        try:
            sidecar.unlink()
        except FileNotFoundError:
            continue
        except OSError as exc:
            raise OSError(
                f"the old records' journal beside {target.name} could not be taken "
                f"away ({exc.strerror or exc}); a copy put back next to it would "
                f"replay the old rows into the new file.  Nothing of the records "
                f"was changed — close anything that is reading the card and try "
                f"again.") from exc
        gone.append(sidecar.name)
    return gone


def put_database(source: Path, target: Path, dry: bool) -> dict:
    """Replace the records in one atomic step; a stale WAL must not survive.

    The order matters and is the whole point of this function:

    1. the old journal is drained (``drain_sidecars`` — see there for why, with the
       measurement), and a drain that cannot be done stops the restore **before**
       anything is written, so a refusal is never a half-restored box;
    2. the copy is made beside the target, fsynced and renamed into place in one
       move, so no reader can see a partial database;
    3. the drain is repeated, because a writer that slipped in between 1 and 2
       would otherwise leave a fresh journal describing rows the file no longer
       holds.

    ``ark_self_heal._copy_over()`` does exactly the same, in the same order, for
    the same reason: those two are the only programs on the box that replace a
    database, and they must not disagree about what "put back" means.
    """
    if dry:
        return {"what": "records", "action": "would replace", "path": str(target)}
    target.parent.mkdir(parents=True, exist_ok=True)
    try:
        drain_sidecars(target)              # 1. the old journal must not survive
    except OSError as exc:
        raise RestoreRefused(str(exc)) from exc
    staging = target.with_name(target.name + ".restoring")
    shutil.copyfile(source, staging)        # 2. the copy lands, then one rename
    with open(staging, "rb+") as handle:
        os.fsync(handle.fileno())
    os.chmod(staging, 0o640)
    os.replace(staging, target)
    try:
        drain_sidecars(target)              # 3. nothing written by the old database
    except OSError as exc:
        raise RestoreRefused(
            f"the records were put back, but {exc}  Do not start the box until "
            f"{target.name}-wal is gone: it holds rows that are not in the file.") from exc
    return {"what": "records", "action": "put back", "path": str(target)}


def put_file(source: Path, target: Path, dry: bool) -> dict:
    """Add a missing shared file.  Never replace one that is already there."""
    if target.exists():
        if bundle_tools.sha256_file(target) == bundle_tools.sha256_file(source):
            return {"what": "file", "action": "already here", "path": str(target)}
        return {"what": "file", "action": "kept the one already here", "path": str(target)}
    if dry:
        return {"what": "file", "action": "would add", "path": str(target)}
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, target)
    os.chmod(target, 0o644)
    return {"what": "file", "action": "put back", "path": str(target)}


def put_private_file(source: Path, target: Path, dry: bool,
                     replace: bool = False) -> dict:
    """Put a named player's save back.  It belongs to one name, so it stays 0600.

    ``replace`` is true only for a forced restore, where the database being put
    back names these exact saves: keeping an older file whose bytes disagree with
    the restored row would create a permanent conflict on the player's next save.
    A file that already matches is left alone.
    """
    if target.exists():
        if bundle_tools.sha256_file(target) == bundle_tools.sha256_file(source):
            return {"what": "game save", "action": "already here", "path": str(target)}
        if not replace:
            return {"what": "game save", "action": "kept the one already here",
                    "path": str(target)}
    if dry:
        return {"what": "game save",
                "action": "would replace" if target.exists() else "would add",
                "path": str(target)}
    target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    for folder in (target.parent, target.parent.parent):
        try:
            os.chmod(folder, 0o700)
        except OSError:
            pass
    shutil.copyfile(source, target)
    os.chmod(target, 0o600)
    return {"what": "game save", "action": "put back", "path": str(target)}


def put_ledger(source: Path, paths: dict, dry: bool, mode: str) -> dict:
    """The import list only means something next to the shelf it describes."""
    real = paths["ledger"]
    beside = real.with_name(real.name + ".from-backup")
    if mode == "no":
        return {"what": "import list", "action": "left in the backup", "path": str(real)}
    shelf_ready = paths["shelf"].is_file() and paths["shelf"].stat().st_size > 0
    wanted = real if (mode == "yes" or shelf_ready) else beside
    if dry:
        return {"what": "import list",
                "action": "would put back" if wanted == real else "would set beside the empty shelf",
                "path": str(wanted)}
    wanted.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, wanted)
    os.chmod(wanted, 0o644)
    return {"what": "import list",
            "action": "put back" if wanted == real else "set beside the empty shelf",
            "path": str(wanted)}


def give_to_box(results: list[dict], *, keep_owner: bool, dry: bool) -> None:
    """Hand everything just written to the account the box's pages run as.

    ``ark-restore`` is run with ``sudo``, so without this the records and the shared
    files come back ``root:root`` and the owner's page cannot read them — the same
    fault as the root-made backup bundle (§16.3).  ``--keep-owner`` keeps whatever
    the bundle carried, and a read-only card is not a restore failure.
    """
    if dry or keep_owner:
        return
    try:
        account = pwd.getpwnam(os.environ.get("ARK_PI_USER", "pi"))
    except KeyError:
        say("(There is no 'pi' account on this machine, so file ownership was"
            " left as it is.)")
        return
    owner = (account.pw_uid, account.pw_gid)
    for result in results:
        path = Path(result["path"])
        if path.exists():
            try:
                os.chown(path, owner[0], owner[1])
            except OSError:
                pass            # a read-only card is not a restore failure


# ---------------------------------------------------------------------------
#  the run
# ---------------------------------------------------------------------------
def restore(bundle_path: Path, *, force: bool, dry: bool, no_files: bool,
            ledger_mode: str, keep_owner: bool, no_service: bool = False) -> int:
    paths = bundle_tools.box_paths()
    data, problems = bundle_tools.verify_bundle(bundle_path)
    if problems or data is None:
        say(f"Refused: {bundle_path.name} is not a bundle this tool can trust — it is"
            " damaged or incomplete.")
        for problem in problems:
            say(f"  - {problem}")
        say("Nothing on the box was changed.  Make a fresh backup of the box as it is now,"
            " or find a copy whose fingerprints all match (`ark-backup --verify <folder>`).")
        return 1
    say(f"Checked {len(data['entries'])} files in {bundle_path.name}: every fingerprint matches.")

    why = occupancy(paths)
    if why and not force:
        return stop(f"{why}.  Putting a backup over it would replace those records.\n"
                    "  If that is really what you want, run the same command again with "
                    "--force on the end.\n  Nothing has been changed.")
    if why and force:
        say(f"This box {why}; replacing it because you said --force.")

    paused: list[str] = []
    if not no_service:
        paused, problem = quiesce(dry)
        if problem:
            return stop(problem)
    elif not dry:
        say("Leaving the services alone because you said --no-service.")

    results = []
    refusal = ""
    try:
        for entry in data["entries"]:
            to = entry.get("to")
            if not to:
                continue                                # RESTORE-ME.txt and friends
            target = inside_or_none(paths["root"], to)
            if target is None:
                return stop(f"the manifest wants to write outside the box: {to!r} — refused")
            source = bundle_path / entry["path"]
            if entry["path"] == "database/ark.db":
                results.append(put_database(source, target, dry))
            elif entry["path"].startswith("calibre-incoming/"):
                results.append(put_ledger(source, paths, dry,
                                          "no" if no_files else ledger_mode))
            elif entry["path"].startswith("arcade-saves/"):
                if not no_files:
                    results.append(put_private_file(source, target, dry,
                                                    replace=force))
            elif not no_files:
                results.append(put_file(source, target, dry))
    except RestoreRefused as refused:
        # A refusal is only worth what it protects: everything already written keeps
        # its owner, the file it refused is untouched, and the box is started again.
        refusal = str(refused)
    finally:
        give_to_box(results, keep_owner=keep_owner, dry=dry)
        if paused:
            resume(paused)

    say("")
    for result in results:
        say(f"  {result['action']:<28} {result['path']}")
    if refusal:
        return stop(f"{refusal}\n  Everything written before it is listed above; the"
                    " file it refused was not touched.")
    if dry:
        say("\nNothing was written (--dry-run).")
        return 0
    say("")
    say("Done.  The records are in place"
        + (" and everything paused for the copy has been started again."
           if paused else "."))
    if ledger_mode == "auto" and not no_files:
        beside = paths["ledger"].with_name(paths["ledger"].name + ".from-backup")
        if beside.exists():
            say("The book shelf is empty, so the import list was set beside it"
                " (…imported.json.from-backup) instead of hiding books that are"
                " not there any more.  Add the books again and they import once.")
    return 0


def inside_or_none(root: Path, rel: str) -> Path | None:
    safe = bundle_tools.safe_rel(rel)
    if safe is None:
        return None
    root = Path(root)
    try:
        root.mkdir(parents=True, exist_ok=True)
    except OSError:
        return None
    return bundle_tools.inside(root, safe)


def show_list(folder: Path) -> int:
    finished = bundle_tools.existing_bundles(folder)
    if not finished:
        say(f"No backups in {folder} yet.")
        return 0
    say(f"Backups in {folder} (newest last):")
    for item in finished:
        files, size = bundle_tools.bundle_size(item)
        try:
            when = bundle_tools.read_manifest(item).get("created", "?").replace("T", " ")[:16]
        except (OSError, ValueError):
            when = "?"
        say(f"  {item.name}   {when}   {bundle_tools.human_size(size):>9}   {files} files")
    say(f"\nPut one back with: sudo ark-restore --from {finished[-1]}")
    return 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        prog="ark-restore",
        description="Put a backup back on a box, after proving the backup is whole.")
    parser.add_argument("--from", dest="source", default=None,
                        help="the backup folder to put back")
    parser.add_argument("--list", action="store_true",
                        help="show the backups this box can see")
    parser.add_argument("--dry-run", action="store_true",
                        help="prove the backup and say what would happen, write nothing")
    parser.add_argument("--force", action="store_true",
                        help="replace the records of a box that already has some")
    parser.add_argument("--no-files", action="store_true",
                        help="records only; leave the File Box and the import list alone")
    parser.add_argument("--ledger", choices=("auto", "yes", "no"), default="auto",
                        help="put the import list back (auto: only beside a real shelf)")
    parser.add_argument("--keep-owner", action="store_true",
                        help="do not change file ownership to the box's user")
    parser.add_argument("--no-service", action="store_true",
                        help="do not pause/start the box's services (a card in a reader)")
    args = parser.parse_args(argv)

    paths = bundle_tools.box_paths()
    if args.list:
        return show_list(paths["backups"])
    if not args.source:
        return stop("say which backup to put back, for example:\n"
                    "  sudo ark-restore --from /srv/ark/backup/ark-backup-20261024-101500\n"
                    "(`ark-restore --list` shows what is there)")
    return restore(Path(args.source), force=args.force, dry=args.dry_run,
                   no_files=args.no_files, ledger_mode=args.ledger,
                   keep_owner=args.keep_owner, no_service=args.no_service)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("Stopped.", file=sys.stderr)
        sys.exit(130)
    except Exception as exc:                    # noqa: BLE001 — say it plainly, exit 1
        print(f"Not done: {exc.__class__.__name__}: {exc}", file=sys.stderr)
        sys.exit(1)
